# Miirra Pay SPA — environment (Vite)
# Copy to `.env` and fill in. Only VITE_* vars are exposed to the browser.

# Clerk publishable key (Dashboard → API keys). Enables phone sign-in/up.
VITE_CLERK_PUBLISHABLE_KEY=

# Optional: override the API base (defaults to same origin; dev proxy handles it).
# VITE_API_BASE=http://127.0.0.1:8791